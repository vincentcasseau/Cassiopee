#!/bin/bash
# Print help message
usage() {
    cat <<EOF
Parallel python launcher of CASSIOPEE.
  kpython -n 2 script.py          : 2 processes, threads chosen from available resources
  kpython -n2 -t4 script.py       : 2 processes with 4 threads each
  kpython -a "env::" -n2 script.py: extra option(s) for the launcher (mpirun)
  kpython -p script.py            : python profiling (cProfile)
  kpython -s / -g                 : sanitizer / gdb

Configurations stored in JSON dicts (see "$CASSIOPEE/etc/templates/kpythonUserConfigs.json").
EOF
}

# Sanitize inputs
if [ $# -eq 0 ]; then
    usage >&2; exit 1
fi

if [ -z "$CASSIOPEE" ]; then
    echo "Environment variable CASSIOPEE must be set."
    echo "CASSIOPEE identifies the root directory of the Cassiopee repository."
    usage >&2; exit 1
fi

if [ -z "$ELSAPROD" ]; then
    echo "Environment variable ELSAPROD must be set."
    echo "ELSAPROD identifies the target machine or computing environment."
    usage >&2; exit 1
fi

# kpython configuration dicts
DEV_PRODS=$(dirname "$(readlink -f "$0")")/kpythonConfigs.json
USER_PRODS="$CASSIOPEE/etc/templates/kpythonUserConfigs.json"   # optional

# python executable (may contain several words, e.g. "vglrun python")
: "${PYTHONEXE:=python}"
PYCMD=($PYTHONEXE)   # intentional word splitting

# OMP_NUM_THREADS init
OMPNUMTHREADSINIT=${OMP_NUM_THREADS:-1}

# Resources
if [ -n "$OMP_NUM_THREADS" ]; then
    ncpu=$OMP_NUM_THREADS # assume env OMP_NUM_THREADS = all available cores
else
    ncpu=$(grep -c '^processor' /proc/cpuinfo 2>/dev/null)
    [ -z "$ncpu" ] || [ "$ncpu" -lt 1 ] && ncpu=1
fi

NPROCS="0"        # (-n) number of mpi processes
NTHREADS="0"      # (-t) number of threads
USER_ARGS=()      # (-a) extra args for the launcher
PYARGS=()         # args for python itself
SANITIZE="0"      # (-s)
GDB="0"           # (-g)

while getopts :hpsgn:t:a: OPTION
do
    case $OPTION in
        h) usage; exit 0 ;;
        n)
            if [[ ${OPTARG:0:1} == "p" ]]; then
                NPROCS=${OPTARG:1}
            else
                NPROCS=$OPTARG
            fi
            ;;
        t) NTHREADS=$OPTARG ;;
        a) USER_ARGS+=($OPTARG) ;;
        p) PYARGS+=(-m cProfile -s tottime) ;;
        s) SANITIZE="1" ;;
        g) GDB="1" ;;
        :)
            echo "kpython: option -$OPTARG requires an argument" >&2
            usage >&2; exit 1
            ;;
        \?) PYARGS+=("-$OPTARG") ;;
    esac
done
shift $((OPTIND-1))

SCRIPT_ARGS=("$@")

# Threads
if [ "$NTHREADS" = "0" ]; then
    if [ "$NPROCS" != "0" ]; then
        NTHREADS=$(( ncpu / NPROCS ))
    else
        NTHREADS=$ncpu
    fi
    [ "$NTHREADS" -lt 1 ] && NTHREADS=1
fi
echo "Running ${SCRIPT_ARGS[*]} with Nprocs=$NPROCS and Nthreads=$NTHREADS"

if [ "$SANITIZE" = "1" ] && [ -z "$ASAN_LIB" ]; then
    echo "kpython: warning: -s given but ASAN_LIB is not set" >&2
fi

#######################################################################
# Launcher configuration (JSON)
#
# Two dicts, keys = prod names (a "_i8" suffix, e.g. sator_gcc_i8, is the
# int64 variant of a prod):
#   - developer prods: $KPYTHON_PRODS (default: kpython_prods.json next to
#     this script)
#   - user prods, optional: $KPYTHON_USER_PRODS (default: ~/.kpython_prods.json)
#
# Lookup of $ELSAPROD, from most to least specific, e.g. sator_gcc_i8:
#   sator_gcc_i8 -> sator_gcc -> sator -> default
# (a trailing number is also tried stripped: sator_coda2 -> sator_coda).
# For each name, user prods are checked first, then developer prods.
# KPYTHON_DEBUG=1 prints which entry was selected.
#
# Entry keys: launcher, nprocs_flag, args, sanitize_args, env, extends.
# Placeholders: {nthreads} {nprocs} {asan_lib}.
# "extends": name of another prod (user prods first, then developer prods);
# keys of the child override the parent's. A user prod may extend the
# developer prod of the same name.
#
# Output of parse_conf, one item per line:
#   L=launcher  F=nprocs flag  A=argument  E=KEY=VALUE (env)
parse_conf() {
"${PYCMD[@]}" - "$DEV_PRODS" "$USER_PRODS" "$ELSAPROD" "$NTHREADS" "$NPROCS" "$ASAN_LIB" "$SANITIZE" <<'PYEOF'
import json, os, sys
dev_file, user_file, prod, nthreads, nprocs, asan, sanitize = sys.argv[1:8]
subs = {"{nthreads}": nthreads, "{nprocs}": nprocs, "{asan_lib}": asan}

def sub(s):
    for k, v in subs.items():
        s = s.replace(k, v)
    return s

def read(path, required):
    if not os.path.isfile(path):
        if required:
            sys.exit("kpython: prods file not found: %s" % path)
        return {}
    try:
        with open(path) as f:
            d = json.load(f)
    except (IOError, ValueError) as e:
        sys.exit("kpython: cannot read %s: %s" % (path, e))
    if not isinstance(d, dict):
        sys.exit("kpython: %s must contain a JSON dict" % path)
    return d

user = read(user_file, False)
dev = read(dev_file, True)

def get(name, srcs=("user", "devel")):
    for s in srcs:
        d = user if s == "user" else dev
        if name in d:
            return s, d[name]
    return None, None

def candidates(p):
    while p:
        yield p
        if p.endswith("_i8"):          # int64 variant falls back to base prod
            p = p[:-3]
            continue
        q = p.rstrip("0123456789")     # sator_coda2 -> sator_coda
        if q and q != p:
            yield q
        if "_" not in p:
            break
        p = p.rsplit("_", 1)[0]
    yield "default"

def resolve(src, name, c, seen=()):
    key = (src, name)
    if key in seen:
        sys.exit("kpython: circular 'extends' involving %s" % name)
    c = dict(c)
    base = c.pop("extends", None)
    if not base:
        return c
    srcs = ("devel",) if (base == name and src == "user") else ("user", "devel")
    bsrc, b = get(base, srcs)
    if b is None:
        sys.exit("kpython: prod '%s' extends unknown prod '%s'" % (name, base))
    out = resolve(bsrc, base, b, seen + (key,))
    out.update(c)
    return out

for cand in candidates(prod):
    src, entry = get(cand)
    if entry is not None:
        break
else:
    sys.exit("kpython: no entry for '%s' and no 'default' in %s" % (prod, dev_file))

if os.environ.get("KPYTHON_DEBUG"):
    sys.stderr.write("kpython: ELSAPROD=%s -> '%s' from %s prods\n" % (prod, cand, src))

c = resolve(src, cand, entry)
print("L=" + c.get("launcher", "mpirun"))
print("F=" + c.get("nprocs_flag", "-np"))
for a in c.get("args", []):
    print("A=" + sub(a))
if sanitize == "1":
    for a in c.get("sanitize_args", []):
        print("A=" + sub(a))
for k, v in c.get("env", {}).items():
    print("E=%s=%s" % (k, sub(v)))
PYEOF
}

#######################################################################
# Run
#######################################################################

export OMP_NUM_THREADS=$NTHREADS

if [ "$NPROCS" = "0" ]; then
    # Sequential run
    export MPIRUN=0
    CMD=("${PYCMD[@]}" "${USER_ARGS[@]}" "${PYARGS[@]}" "${SCRIPT_ARGS[@]}")
    [ "$GDB" = "1" ] && CMD=(gdb --args "${CMD[@]}")
    if [ "$SANITIZE" = "1" ]; then
        LD_PRELOAD=$ASAN_LIB "${CMD[@]}"
    else
        "${CMD[@]}"
    fi
    exitcode=$?
else
    # Parallel run
    export MPIRUN=1
    CONF_OUT=$(parse_conf) || exit 1

    LAUNCHER=mpirun
    NPFLAG=-np
    CONF_ARGS=()
    while IFS= read -r line; do
        case ${line%%=*} in
            L) LAUNCHER=${line#*=} ;;
            F) NPFLAG=${line#*=} ;;
            A) CONF_ARGS+=("${line#*=}") ;;
            E) export "${line#*=}" ;;
        esac
    done <<< "$CONF_OUT"

    # GDB is not supported in parallel mode
    "$LAUNCHER" "${USER_ARGS[@]}" "${CONF_ARGS[@]}" "$NPFLAG" "$NPROCS" \
        "${PYCMD[@]}" "${PYARGS[@]}" "${SCRIPT_ARGS[@]}"
    exitcode=$?
fi

unset MPIRUN
export OMP_NUM_THREADS=$OMPNUMTHREADSINIT

# Propagate the exit code
exit $exitcode
